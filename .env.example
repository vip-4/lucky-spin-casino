# Lucky Spin Casino - R2 部署环境变量模板
# 复制此文件为 .env，并填入你的 Cloudflare R2 凭证
# ⚠️ 绝对不要将真实凭证提交到版本控制系统

# R2 S3 兼容凭证（从 Cloudflare 控制台 R2 > 存储桶 > S3 API 凭证获取）
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# R2 API 端点（按你的 Account ID 替换）
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# R2 存储桶名称（需在 Cloudflare 控制台先创建）
R2_BUCKET_NAME=lucky-spin-casino

# 可选：R2 绑定的公共域名，用于生成上传后的 public URL
# 例如：https://cdn.lucky-spin-casino.example.com 或 https://lucky-spin-casino.<account>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# 本地文件目录（默认为脚本上级目录，即 casino-game 根目录）
R2_LOCAL_DIR=.